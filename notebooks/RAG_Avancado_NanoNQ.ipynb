    "## 11. Geração aumentada — resposta com citações\n",
    "\n",
    "A função `rag_answer` junta tudo. O prompt de sistema força o modelo a usar só o contexto, citar `[n]` e admitir\n",
    "quando não sabe — isso reduz alucinação e torna a resposta verificável."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "731561c2",
   "metadata": {},
   "outputs": [],
   "source": [
    "def retrieve(question, mode=\"avancado\", k=K_CONTEXT, use_hyde=False):\n",
    "    if mode == \"naive\":\n",
    "        ids = dense_search([question])[0][0].tolist()\n",
    "    else:\n",
    "        dq = hyde_expand(question) if use_hyde else question\n",
    "        fused = [c for c, _ in rrf_fuse([bm25_search(question)[0].tolist(),\n",
    "                                         dense_search([dq])[0][0].tolist()], top_n=K_RERANK)]\n",
    "        ids = rerank(question, fused)[0]\n",
    "    out, seen = [], set()           # um chunk por documento, para diversificar o contexto\n",
    "    for c in ids:\n",
    "        if chunk_doc_ids[c] not in seen:\n",
    "            seen.add(chunk_doc_ids[c]); out.append(c)\n",
    "        if len(out) == k: break\n",
    "    return out\n",
    "\n",
    "def rag_answer(question, mode=\"avancado\", k=K_CONTEXT, use_hyde=False, verbose=True):\n",
    "    ids = retrieve(question, mode, k, use_hyde)\n",
    "    answer = llm_chat(build_messages(question, [chunk_texts[c] for c in ids]))\n",
    "    if verbose:\n",
    "        print(f\"❓ {question}\\n\\n💬 {answer}\\n\\n📚 Fontes:\")\n",
    "        for i, c in enumerate(ids, 1):\n",
    "            print(f\"  [{i}] ({chunk_doc_ids[c]}) {chunk_texts[c][:120]}…\")\n",
    "    return answer, ids\n",
    "\n",
    "_ = rag_answer(queries[qid_list[0]])"
   ]
  },
