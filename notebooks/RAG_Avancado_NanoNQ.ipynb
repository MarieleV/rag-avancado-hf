    "    rows.append({\"Pergunta\": q,\n",
    "                 \"Naive (gold no contexto?)\": f\"{'✅' if {chunk_doc_ids[c] for c in ids_n} & gold else '❌'} {a_naive}\",\n",
    "                 \"Avançado (gold no contexto?)\": f\"{'✅' if {chunk_doc_ids[c] for c in ids_a} & gold else '❌'} {a_adv}\"})\n",
    "pd.set_option(\"display.max_colwidth\", 400)\n",
