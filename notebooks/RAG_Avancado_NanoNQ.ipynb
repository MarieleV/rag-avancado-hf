    "import os, json, time, random\n",
    "import numpy as np, pandas as pd, torch\n",
    "\n",
    "SEED = 42\n",
    "random.seed(SEED); np.random.seed(SEED); torch.manual_seed(SEED)\n",
    "DEVICE = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
    "print(\"Dispositivo:\", DEVICE, \"|\", torch.cuda.get_device_name(0) if DEVICE == \"cuda\" else \"sem GPU\")\n",
    "\n",
    "# ---- Configuração central do experimento (altere aqui) ----\n",
    "DATASET_ID   = \"hakari-bench/NanoBEIR-pt\"\n",
    "SPLIT        = \"NanoNQ\"\n",
    "EMBED_MODEL  = \"BAAI/bge-m3\"                    # alternativa: \"Qwen/Qwen3-Embedding-0.6B\"\n",
    "RERANK_MODEL = \"BAAI/bge-reranker-v2-m3\"        # alternativa: \"Qwen/Qwen3-Reranker-0.6B\" (versão seq-cls)\n",
    "LLM_MODEL    = \"Qwen/Qwen3-4B-Instruct-2507\"\n",
    "USE_4BIT     = True        # quantização bitsandbytes (economiza VRAM na T4)\n",
    "CHUNK_SIZE, CHUNK_OVERLAP = 800, 120\n",
    "K_CANDIDATES = 50          # candidatos por recuperador\n",
    "K_RERANK     = 30          # quantos candidatos vão para o cross-encoder\n",
    "K_CONTEXT    = 5           # quantos trechos entram no prompt do LLM"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "7fcf1963",
   "metadata": {},
   "source": [
    "## 1. Funções base do pipeline\n",
    "\n",
    "Funções puras (sem modelos) — chunking, tokenização para BM25, fusão RRF e métricas de avaliação.\n",
    "O mesmo código é usado no app do Hugging Face Spaces (`rag_core.py`).\n",
    "\n",
    "**Métricas** (calculadas no nível de documento):\n",
    "- **Recall@k** — fração das passagens corretas que aparecem entre as k primeiras.\n",
    "- **MRR@10** — 1/posição da primeira passagem correta (quanto mais perto do topo, melhor).\n",
    "- **nDCG@10** — ganho acumulado com desconto logarítmico pela posição; métrica padrão do BEIR/MTEB."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "650a9d79",
   "metadata": {},
   "outputs": [],
   "source": [
    "\"\"\"Funções puras do pipeline RAG (sem dependência de modelos).\n",
    "\n",
    "Usadas tanto no notebook quanto no app do Hugging Face Spaces.\n",
    "\"\"\"\n",
    "import math\n",
    "import re\n",
    "import unicodedata\n",
    "\n",
    "# ---------------------------------------------------------------- chunking\n",
    "def chunk_text(text: str, size: int = 800, overlap: int = 120) -> list[str]:\n",
    "    \"\"\"Divide o texto em pedaços de até `size` caracteres, respeitando fim de frase\n",
    "    sempre que possível e repetindo ~`overlap` caracteres entre pedaços vizinhos.\"\"\"\n",
    "    text = \" \".join(str(text).split())\n",
    "    if len(text) <= size:\n",
    "        return [text] if text else []\n",
    "    sentences = re.split(r\"(?<=[.!?])\\s+\", text)\n",
    "    chunks, cur = [], \"\"\n",
    "    for s in sentences:\n",
    "        if len(cur) + len(s) + 1 <= size:\n",
    "            cur = f\"{cur} {s}\".strip()\n",
    "            continue\n",
    "        if cur:\n",
    "            chunks.append(cur)\n",
    "            tail = cur[-overlap:]\n",
    "            tail = tail.split(\" \", 1)[-1] if \" \" in tail else tail  # começa em palavra inteira\n",
    "            cur = f\"{tail} {s}\".strip()\n",
    "        else:\n",
    "            cur = s\n",
    "        while len(cur) > size:  # frase gigante: corte duro com sobreposição\n",
    "            chunks.append(cur[:size])\n",
    "            cur = cur[size - overlap:]\n",
    "    if cur:\n",
    "        chunks.append(cur)\n",
    "    return chunks\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------ tokenização BM25\n",
    "def _strip_accents(t: str) -> str:\n",
    "    t = unicodedata.normalize(\"NFKD\", t)\n",
    "    return \"\".join(c for c in t if not unicodedata.combining(c))\n",
    "\n",
    "_STOP_RAW = \"\"\"a o e é de da do das dos em no na nos nas um uma uns umas para pra por pelo pela\n",
    "pelos pelas com sem que se ao aos à às ou como mais mas foi foram ser era eram seu sua seus\n",
    "suas ele ela eles elas isso isto esse essa este esta aquele aquela qual quais quem onde quando\n",
    "também já não sim há tem têm entre sobre até após muito muitos muita muitas me te lhe nós vós\"\"\"\n",
    "STOPWORDS = {_strip_accents(w) for w in _STOP_RAW.split()}\n",
    "\n",
    "def tokenize(text: str) -> list[str]:\n",
    "    \"\"\"minúsculas + remoção de acentos + remoção de stopwords (pt-BR).\"\"\"\n",
    "    t = _strip_accents(str(text).lower())\n",
    "    return [w for w in re.findall(r\"\\w+\", t) if len(w) > 1 and w not in STOPWORDS]\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------------- fusão\n",
    "def rrf_fuse(rankings: list[list[int]], k: int = 60, top_n: int | None = None) -> list[tuple[int, float]]:\n",
    "    \"\"\"Reciprocal Rank Fusion: score(d) = soma 1/(k + posição). Recebe listas de ids\n",
    "    (ordenadas da melhor para a pior) e devolve [(id, score)] ordenado.\"\"\"\n",
    "    scores: dict[int, float] = {}\n",
    "    for ranking in rankings:\n",
    "        for pos, idx in enumerate(ranking, start=1):\n",
    "            scores[idx] = scores.get(idx, 0.0) + 1.0 / (k + pos)\n",
    "    fused = sorted(scores.items(), key=lambda x: x[1], reverse=True)\n",
    "    return fused[:top_n] if top_n else fused\n",
    "\n",
    "\n",
    "def to_doc_ranking(chunk_ids: list[int], chunk_doc_ids: list[str]) -> list[str]:\n",
    "    \"\"\"Converte ranking de chunks em ranking de documentos (mantém a 1ª aparição).\"\"\"\n",
    "    seen, docs = set(), []\n",
    "    for cid in chunk_ids:\n",
    "        d = chunk_doc_ids[cid]\n",
    "        if d not in seen:\n",
    "            seen.add(d)\n",
    "            docs.append(d)\n",
    "    return docs\n",
    "\n",
    "\n",
    "# ----------------------------------------------------------------- métricas\n",
    "def recall_at_k(ranked: list[str], relevant: set[str], k: int) -> float:\n",
    "    return len(set(ranked[:k]) & relevant) / len(relevant) if relevant else 0.0\n",
    "\n",
    "def mrr_at_k(ranked: list[str], relevant: set[str], k: int = 10) -> float:\n",
    "    for i, d in enumerate(ranked[:k], start=1):\n",
    "        if d in relevant:\n",
    "            return 1.0 / i\n",
    "    return 0.0\n",
    "\n",
    "def ndcg_at_k(ranked: list[str], relevant: set[str], k: int = 10) -> float:\n",
    "    dcg = sum(1.0 / math.log2(i + 1) for i, d in enumerate(ranked[:k], start=1) if d in relevant)\n",
    "    ideal = sum(1.0 / math.log2(i + 1) for i in range(1, min(len(relevant), k) + 1))\n",
    "    return dcg / ideal if ideal else 0.0\n",
    "\n",
    "def evaluate(runs: dict[str, list[str]], qrels: dict[str, set[str]], ks=(1, 3, 5, 10)) -> dict[str, float]:\n",
    "    \"\"\"runs: {query_id: [doc_ids ranqueados]} → médias das métricas.\"\"\"\n",
    "    out = {f\"Recall@{k}\": 0.0 for k in ks}\n",
    "    out.update({\"MRR@10\": 0.0, \"nDCG@10\": 0.0})\n",
    "    n = 0\n",
    "    for qid, rel in qrels.items():\n",
    "        ranked = runs.get(qid, [])\n",
    "        for k in ks:\n",
    "            out[f\"Recall@{k}\"] += recall_at_k(ranked, rel, k)\n",
    "        out[\"MRR@10\"] += mrr_at_k(ranked, rel)\n",
    "        out[\"nDCG@10\"] += ndcg_at_k(ranked, rel)\n",
    "        n += 1\n",
    "    return {m: round(v / max(n, 1), 4) for m, v in out.items()}\n",
    "\n",
    "\n",
    "# ----------------------------------------------------------------- prompts\n",
    "SYSTEM_PROMPT = (\n",
    "    \"Você é um assistente que responde perguntas em português do Brasil usando APENAS \"\n",
    "    \"os trechos de contexto fornecidos. Regras:\\n\"\n",
    "    \"1. Cite as fontes entre colchetes, como [1] ou [2][3], logo após cada afirmação.\\n\"\n",
    "    \"2. Se o contexto não contiver a resposta, diga exatamente: \"\n",
    "    \"\\\"Não encontrei essa informação nos documentos.\\\"\\n\"\n",
    "    \"3. Seja direto: no máximo 4 frases.\"\n",
    ")\n",
    "\n",
    "def build_messages(question: str, passages: list[str]) -> list[dict]:\n",
    "    ctx = \"\\n\\n\".join(f\"[{i}] {p}\" for i, p in enumerate(passages, start=1))\n",
    "    return [\n",
    "        {\"role\": \"system\", \"content\": SYSTEM_PROMPT},\n",
    "        {\"role\": \"user\", \"content\": f\"Contexto:\\n{ctx}\\n\\nPergunta: {question}\\n\\nResposta:\"},\n",
    "    ]\n",
    "\n",
    "HYDE_PROMPT = (\n",
    "    \"Escreva um parágrafo curto (3 a 4 frases), em estilo de enciclopédia e em português, \"\n",
    "    \"que responda à pergunta abaixo. Se não souber, invente um texto plausível — ele será \"\n",
    "    \"usado apenas para busca semântica.\\n\\nPergunta: {q}\\n\\nParágrafo:\"\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f170d2f0",
   "metadata": {},
   "source": [
    "## 2. Dataset do Hugging Face Hub"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b59e2767",
   "metadata": {},
   "outputs": [],
   "source": [
    "from datasets import load_dataset\n",
    "\n",
    "corpus_ds  = load_dataset(DATASET_ID, \"corpus\",  split=SPLIT)\n",
    "queries_ds = load_dataset(DATASET_ID, \"queries\", split=SPLIT)\n",
    "qrels_ds   = load_dataset(DATASET_ID, \"qrels\",   split=SPLIT)\n",
    "\n",
    "doc_ids   = [str(x) for x in corpus_ds[\"_id\"]]\n",
    "doc_texts = corpus_ds[\"text\"]\n",
    "queries   = {str(q[\"_id\"]): q[\"text\"] for q in queries_ds}\n",
    "qrels = {}\n",
    "for r in qrels_ds:\n",
    "    qrels.setdefault(str(r[\"query-id\"]), set()).add(str(r[\"corpus-id\"]))\n",
    "doc_text_by_id = dict(zip(doc_ids, doc_texts))\n",
    "\n",
    "print(f\"Documentos: {len(doc_ids):,} | Perguntas: {len(queries)} | Pares relevantes: {sum(map(len, qrels.values()))}\")\n",
    "lens = pd.Series([len(t) for t in doc_texts])\n",
    "print(\"Tamanho dos documentos (caracteres):\", lens.describe()[[\"mean\", \"50%\", \"max\"]].round(0).to_dict())\n",
    "for qid in list(queries)[:3]:\n",
    "    print(f\"\\n❓ {queries[qid]}\\n✅ {doc_text_by_id[next(iter(qrels[qid]))][:250]}…\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "009466c9",
   "metadata": {},
   "source": [
    "## 3. Chunking\n",
    "\n",
    "Documentos longos são quebrados em pedaços de até 800 caracteres, respeitando fim de frase e com 120 caracteres\n",
    "de sobreposição — assim uma informação que cai na fronteira entre dois pedaços não se perde.\n",
    "Cada chunk guarda o `doc_id` de origem, o que permite citar a fonte e avaliar no nível do documento."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "00a6ebdf",
   "metadata": {},
   "outputs": [],
   "source": [
    "chunk_texts, chunk_doc_ids = [], []\n",
    "for did, text in zip(doc_ids, doc_texts):\n",
    "    for ch in chunk_text(text, CHUNK_SIZE, CHUNK_OVERLAP):\n",
    "        chunk_texts.append(ch)\n",
    "        chunk_doc_ids.append(did)\n",
    "print(f\"{len(doc_ids):,} documentos → {len(chunk_texts):,} chunks \"\n",
    "      f\"({len(chunk_texts)/len(doc_ids):.2f} chunks/doc em média)\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "36b3f7d9",
   "metadata": {},
   "source": [
    "## 4. Embeddings e índice vetorial (RAG *naive*)\n",
    "\n",
    "`BAAI/bge-m3` é um modelo de embedding multilíngue (100+ idiomas, incluindo português), 1024 dimensões e até 8 192\n",
    "tokens. Os vetores são normalizados, então o produto interno no FAISS equivale à similaridade de cosseno.\n",
    "\n",
    "O índice é **armazenado localmente** em disco (`faiss.write_index`) junto com o mapeamento chunk → documento,\n",
    "e pode ser recarregado com `faiss.read_index` sem recalcular os embeddings."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "998b6ce1",
   "metadata": {},
   "outputs": [],
   "source": [
    "%%time\n",
    "import faiss\n",
    "from sentence_transformers import SentenceTransformer\n",
    "\n",
    "embedder = SentenceTransformer(EMBED_MODEL, device=DEVICE,\n",
    "                               model_kwargs={\"torch_dtype\": torch.float16} if DEVICE == \"cuda\" else {})\n",
    "chunk_emb = embedder.encode(chunk_texts, batch_size=64, normalize_embeddings=True,\n",
    "                            show_progress_bar=True, convert_to_numpy=True).astype(\"float32\")\n",
    "index = faiss.IndexFlatIP(chunk_emb.shape[1])\n",
    "index.add(chunk_emb)\n",
    "print(\"Vetores no índice:\", index.ntotal, \"| dimensão:\", chunk_emb.shape[1])\n",
    "\n",
    "# Persistência local do índice vetorial (+ metadados para mapear posição → chunk/documento)\n",
    "INDEX_DIR = \"indice_local\"\n",
    "os.makedirs(INDEX_DIR, exist_ok=True)\n",
    "faiss.write_index(index, f\"{INDEX_DIR}/index.faiss\")\n",
    "with open(f\"{INDEX_DIR}/chunks.json\", \"w\", encoding=\"utf-8\") as f:\n",
    "    json.dump({\"embed_model\": EMBED_MODEL, \"chunk_doc_ids\": chunk_doc_ids, \"chunk_texts\": chunk_texts},\n",
    "              f, ensure_ascii=False)\n",
    "index = faiss.read_index(f\"{INDEX_DIR}/index.faiss\")   # recarrega do disco para provar que funciona\n",
    "print(f\"Índice salvo em {INDEX_DIR}/index.faiss ({os.path.getsize(f'{INDEX_DIR}/index.faiss')/1e6:.1f} MB)\"\n",
    "      f\" e recarregado: {index.ntotal} vetores\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "36b98607",
   "metadata": {},
   "outputs": [],
   "source": [
    "def dense_search(texts, k=K_CANDIDATES):\n",
    "    # Busca densa em lote. Retorna (ids, scores) com shape [n_consultas, k].\n",
    "    q = embedder.encode(list(texts), batch_size=32, normalize_embeddings=True,\n",
    "                        convert_to_numpy=True).astype(\"float32\")\n",
    "    scores, ids = index.search(q, k)\n",
    "    return ids, scores\n",
    "\n",
    "qid_list  = list(qrels)\n",
    "q_texts   = [queries[q] for q in qid_list]\n",
    "\n",
    "t0 = time.time()\n",
    "dense_ids, dense_scores = dense_search(q_texts)\n",
    "lat_dense = (time.time() - t0) / len(q_texts)\n",
    "\n",
    "runs_naive = {qid: to_doc_ranking(dense_ids[i].tolist(), chunk_doc_ids) for i, qid in enumerate(qid_list)}\n",
    "res_naive = evaluate(runs_naive, qrels)\n",
    "res_naive"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "0d9d5068",
   "metadata": {},
   "source": [
    "## 5. O gargalo do RAG simples\n",
    "\n",
    "A busca densa entende *significado*, mas erra em dois casos típicos:\n",
    "1. **Termos exatos** (nomes próprios, números, siglas) que o embedding \"dilui\".\n",
    "2. **Ruído**: trechos parecidos com a pergunta, mas que não contêm a resposta, ocupam o topo e entram no prompt —\n",
    "   e LLMs tendem a ignorar informação no meio de contextos longos (*lost in the middle*, Liu et al., 2023).\n",
    "\n",
    "Abaixo, perguntas em que a passagem correta **não** apareceu no top-5 da busca densa:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "4b62e2ad",
   "metadata": {},
   "outputs": [],
   "source": [
    "fails = [qid for qid in qid_list if recall_at_k(runs_naive[qid], qrels[qid], 5) == 0]\n",
    "print(f\"{len(fails)} de {len(qid_list)} perguntas sem resposta correta no top-5 denso\\n\")\n",
    "for qid in fails[:3]:\n",
    "    gold = next(iter(qrels[qid]))\n",
    "    pos = runs_naive[qid].index(gold) + 1 if gold in runs_naive[qid] else \"fora do top-50\"\n",
    "    print(f\"❓ {queries[qid]}\\n   posição da passagem correta: {pos}\")\n",
    "    print(f\"   🥇 1º recuperado: {doc_text_by_id[runs_naive[qid][0]][:160]}…\")\n",
    "    print(f\"   ✅ correta:       {doc_text_by_id[gold][:160]}…\\n\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "140a8a26",
   "metadata": {},
   "source": [
    "## 6. Advanced RAG — Busca híbrida (BM25 + denso + RRF)\n",
    "\n",
    "**BM25** pontua pela frequência dos termos exatos (com normalização pelo tamanho do documento) — complementa o\n",
    "denso nos casos de nomes e números. As duas listas são combinadas por **Reciprocal Rank Fusion**:\n",
    "`score(d) = Σ 1 / (60 + posição de d em cada lista)`. O RRF usa só as posições, então não é preciso calibrar\n",
    "escalas de score diferentes."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "64fc3d5e",
   "metadata": {},
   "outputs": [],
   "source": [
    "%%time\n",
    "from rank_bm25 import BM25Okapi\n",
    "bm25 = BM25Okapi([tokenize(t) for t in chunk_texts])\n",
    "\n",
    "def bm25_search(query, k=K_CANDIDATES):\n",
    "    s = bm25.get_scores(tokenize(query))\n",
    "    top = np.argsort(-s)[:k]\n",
    "    return top, s[top]\n",
    "\n",
    "t0 = time.time()\n",
    "bm25_ids = [bm25_search(q)[0].tolist() for q in q_texts]\n",
    "lat_bm25 = (time.time() - t0) / len(q_texts)\n",
    "\n",
    "hybrid_ids = [[cid for cid, _ in rrf_fuse([bm25_ids[i], dense_ids[i].tolist()], k=60, top_n=K_CANDIDATES)]\n",
    "              for i in range(len(qid_list))]\n",
    "\n",
    "runs_bm25   = {qid: to_doc_ranking(bm25_ids[i], chunk_doc_ids)   for i, qid in enumerate(qid_list)}\n",
    "runs_hybrid = {qid: to_doc_ranking(hybrid_ids[i], chunk_doc_ids) for i, qid in enumerate(qid_list)}\n",
    "res_bm25, res_hybrid = evaluate(runs_bm25, qrels), evaluate(runs_hybrid, qrels)\n",
    "pd.DataFrame({\"Denso (naive)\": res_naive, \"BM25\": res_bm25, \"Híbrido (RRF)\": res_hybrid}).T"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "b91fcf85",
   "metadata": {},
   "source": [
    "## 7. Advanced RAG — Reranking com cross-encoder\n",
    "\n",
    "O *bi-encoder* (bge-m3) codifica pergunta e documento **separadamente** — rápido, mas sem interação entre os dois\n",
    "textos. O **cross-encoder** lê `[pergunta + trecho]` juntos, com atenção cruzada entre todos os tokens, e devolve um\n",
    "score de relevância. É muito mais preciso, porém caro demais para o corpus inteiro: por isso só reordena os\n",
    "30 melhores candidatos da busca híbrida (padrão *retrieve-then-rerank*)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e820ee90",
   "metadata": {},
   "outputs": [],
   "source": [
    "from sentence_transformers import CrossEncoder\n",
    "reranker = CrossEncoder(RERANK_MODEL, device=DEVICE, max_length=512,\n",
    "                        model_kwargs={\"torch_dtype\": torch.float16} if DEVICE == \"cuda\" else {})\n",
    "\n",
    "def rerank(query, cand_ids, top_n=None):\n",
    "    cand_ids = list(cand_ids)\n",
    "    scores = reranker.predict([(query, chunk_texts[c]) for c in cand_ids],\n",
    "                              batch_size=32, show_progress_bar=False)\n",
    "    order = np.argsort(-scores)\n",
    "    ranked = [int(cand_ids[j]) for j in order]\n",
    "    return (ranked[:top_n], scores[order][:top_n]) if top_n else (ranked, scores[order])\n",
    "\n",
    "t0 = time.time()\n",
    "rerank_ids = [rerank(q_texts[i], hybrid_ids[i][:K_RERANK])[0] for i in range(len(qid_list))]\n",
    "lat_rerank = (time.time() - t0) / len(q_texts)\n",
    "\n",
    "runs_rerank = {qid: to_doc_ranking(rerank_ids[i], chunk_doc_ids) for i, qid in enumerate(qid_list)}\n",
    "res_rerank = evaluate(runs_rerank, qrels)\n",
    "res_rerank"
   ]
  },
